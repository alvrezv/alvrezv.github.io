<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Frutería Maranatha</title>
<meta name="theme-color" content="#0e0e0e">
<style>
  :root{
    --acento:#8BD450;      /* cambia aquí el color de acento */
    --fondo:#0e0e0e;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{
    min-height:100vh;
    font-family:"Helvetica Neue",Arial,sans-serif;
    color:#fff;
    background:
      linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.85)),
      url("fondo.jpg") center/cover no-repeat fixed,
      var(--fondo);
    display:flex;justify-content:center;
  }
  main{
    width:100%;max-width:440px;
    padding:56px 22px 40px;
    display:flex;flex-direction:column;gap:14px;
  }
  .tag{
    font-size:12px;letter-spacing:.25em;text-transform:uppercase;
    color:var(--acento);font-weight:700;
  }
  h1{
    font-size:46px;line-height:.95;font-weight:900;
    text-transform:uppercase;letter-spacing:-.02em;
    margin-bottom:10px;
  }
  h1 span{color:var(--acento)}
  .btn{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 20px;border-radius:14px;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.18);
    color:#fff;text-decoration:none;
    font-weight:800;font-size:16px;text-transform:uppercase;letter-spacing:.04em;
    backdrop-filter:blur(6px);
    transition:transform .15s,background .15s;
  }
  .btn:active{transform:scale(.98)}
  .btn:hover{background:rgba(255,255,255,.14)}
  .btn.principal{background:var(--acento);color:#0e0e0e;border-color:var(--acento)}
  .btn small{font-weight:600;opacity:.75;text-transform:none;letter-spacing:0}
  .card{
    padding:20px;border-radius:14px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.14);
  }
  .card h2{
    font-size:13px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--acento);margin-bottom:12px;
  }
  .fila{
    display:flex;justify-content:space-between;
    padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1);
    font-size:15px;
  }
  .fila:last-child{border-bottom:0}
  .fila b{font-weight:700}
  .dir{font-size:16px;line-height:1.4;margin-bottom:14px}
  footer{margin-top:10px;text-align:center;font-size:12px;opacity:.5}
</style>
</head>
<body>
<main>
  <div class="tag">Frutería y verdulería</div>
  <h1>Frutería<br><span>Maranatha</span></h1>

  <a class="btn principal" href="https://wa.me/56983301251?text=Hola%2C%20quiero%20hacer%20un%20pedido" target="_blank" rel="noopener">
    WhatsApp <small>+56 9 8330 1251</small>
  </a>

  <a class="btn" href="PONER_LINK_INSTAGRAM" target="_blank" rel="noopener">
    Instagram <small>@PONER_USUARIO</small>
  </a>

  <a class="btn" href="PONER_LINK_GOOGLE_MAPS" target="_blank" rel="noopener">
    Ver en Google Maps <small>→</small>
  </a>

  <div class="card">
    <h2>Horarios</h2>
    <div class="fila"><span>Lunes a viernes</span><b>PONER_HORA</b></div>
    <div class="fila"><span>Sábado</span><b>PONER_HORA</b></div>
    <div class="fila"><span>Domingo</span><b>PONER_HORA</b></div>
  </div>

  <div class="card">
    <h2>Cómo llegar</h2>
    <p class="dir">PONER_DIRECCION_ESCRITA</p>
    <a class="btn principal" href="PONER_LINK_GOOGLE_MAPS" target="_blank" rel="noopener">
      Abrir ruta <small>→</small>
    </a>
  </div>

  <footer>Frutería Maranatha · Hecho con NotName</footer>
</main>
</body>
</html>
